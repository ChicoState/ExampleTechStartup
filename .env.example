# Local PostgreSQL only. Do not use production credentials here.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app_local_development_only
POSTGRES_PORT=5432

# Prisma CLI uses DATABASE_URL. DIRECT_URL is reserved for a future provider integration
# that distinguishes direct migration and pooled application connections.
DATABASE_URL=postgresql://app:app_local_development_only@127.0.0.1:5432/app?schema=public
DIRECT_URL=postgresql://app:app_local_development_only@127.0.0.1:5432/app?schema=public

# Required only after authentication is implemented; use a generated value in local .env.
AUTH_SECRET=replace-with-a-local-secret
